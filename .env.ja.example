# 日本版（紫微館）の環境変数サンプル
# コピーして .env.local / Vercel の Environment Variables に設定する

# 公開URL（末尾スラッシュなし）。OGP・canonical・sitemap の絶対URLに使う
NEXT_PUBLIC_SITE_URL=https://example.jp

# ── アクセス解析（GA4）────────────────────
# 未設定なら GA4 タグを読み込まない
NEXT_PUBLIC_GA_ID=

# ── 有料レポート ─────────────────────────────
# true: β版として全機能無料 / false: 事業レポートを有料モードにする
JP_BETA_FREE=true

# アンロックトークンの署名鍵（本番では必ず32文字以上のランダム文字列に）
JP_UNLOCK_SECRET=change-me-to-a-long-random-string

# 外部決済ページ（Paddle / Lemon Squeezy / Stripe Payment Link など）
# 未設定なら購入ボタンは「決済準備中」になる
JP_CHECKOUT_URL=

# 決済 webhook の署名検証と order token 暗号化の鍵（32 文字以上のランダム文字列）
JP_WEBHOOK_SECRET=

# ── AI 深掘り（任意）──────────────────────────
# OpenAI 互換 API。未設定なら結果ページの AI パネルは表示されない
JP_LLM_API_KEY=
JP_LLM_BASE_URL=https://api.openai.com/v1
JP_LLM_MODEL=gpt-4o-mini
