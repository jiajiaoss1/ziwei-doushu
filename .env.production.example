# 本番用。`cp .env.production.example .env.production` して値を埋める。
# .env.production は絶対に Git にコミットしない。

NEXT_PUBLIC_SITE_URL=https://shibikan.com
NEXT_PUBLIC_GA_ID=

# Caddy の Let's Encrypt 通知先
ACME_EMAIL=admin@shibikan.com

# ベータ版は true。有料化するときは false。
JP_BETA_FREE=true
JP_UNLOCK_SECRET=change-me-to-a-long-random-string
JP_AI_TOKEN_SECRET=change-me-to-another-long-random-string

# AI（未設定なら AI パネルは出ない）
JP_LLM_API_KEY=
JP_LLM_BASE_URL=https://api.openai.com/v1
JP_LLM_MODEL=gpt-4o-mini

# 外部決済（未設定なら「決済準備中」）
JP_CHECKOUT_URL=
